# URL final do site (sem barra no fim). Usada em canonical, Open Graph, sitemap e JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# ID do container do Google Tag Manager (ex.: GTM-ABC1234). Sem ele, o GTM não carrega.
NEXT_PUBLIC_GTM_ID=

# (Opcional) Código de verificação do Google Search Console via meta tag
NEXT_PUBLIC_GSC_VERIFICATION=
